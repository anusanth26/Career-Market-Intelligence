n><column caption="Share with salary" datatype='string' name="[Calculation_postings_5]" role='measure' type='nominal'><calculation class='tableau' formula="STR(ROUND(COUNT([salary_mid]) / COUNT([job_id]) * 100, 0)) + '%'" /></column><column caption="Median salary" datatype='string' name="[Calculation_postings_6]" role='measure' type='nominal'><calculation class='tableau' formula="'₹' + STR(ROUND(MEDIAN([salary_mid]) / 100000, 1)) + 'L'" /></column><column caption="Median salary (₹ lakh)" datatype='real' name="[Calculation_postings_7]" role='measure' type='quantitative'><calculation class='tableau' formula="MEDIAN([salary_mid]) / 100000" /></column><column caption="Salaries known" datatype='integer' name="[Calculation_postings_8]" role='measure' type='quantitative'><calculation class='tableau' formula="COUNT([salary_mid])" /></column><column caption="Seniority known" datatype='boolean' name="[Calculation_postings_9]" role='dimension' type='nominal'><calculation class='tableau' formula="[seniority_level] &lt;&gt; 'Unknown'" /></column></datasource><datasource caption="skill_demand" inline='true' name="federated.skill_demand" version='18.1'><connection class='federated'><named-connections><named-connection caption="skill_demand" name='hyper.skill_demand'><connection authentication='auth-none' class='hyper' dbname="/Users/kireeti/Desktop/Projects/Career-Market-Intelligence/tableau_dashboard/extracts/hyper/skill_demand.hyper" default-settings='yes' schema='Extract' sslmode='' tablename='Extract' username='' /></named-connection></named-connections><relation connection='hyper.skill_demand' name='Extract' table='[Extract].[Extract]' type='table' /></connection><aliases enabled='yes' /></datasource><datasource caption="skill_pairs" inline='true' name="federated.skill_pairs" version='18.1'><connection class='federated'><named-connections><named-connection caption="skill_pairs" name='hyper.skill_pairs'><connection authentication='auth-none' class='hyper' dbname="/Users/kireeti/Desktop/Projects/Career-Market-Intelligence/tableau_dashboard/extracts/hyper/skill_cooccurrence.hyper" default-settings='yes' schema='Extract' sslmode='' tablename='Extract' username='' /></named-connection></named-connections><relation connection='hyper.skill_pairs' name='Extract' table='[Extract].[Extract]' type='table' /></connection><aliases enabled='yes' /><column caption="Pair" datatype='string' name="[Calculation_skill_pairs_1]" role='dimension' type='nominal'><calculation class='tableau' formula="[skill_a] + ' + ' + [skill_b]" /></column></datasource><datasource caption="trends" inline='true' name="federated.trends" version='18.1'><connection class='federated'><named-connections><named-connection caption="trends" name='hyper.trends'><connection authentication='auth-none' class='hyper' dbname="/Users/kireeti/Desktop/Projects/Career-Market-Intelligence/tableau_dashboard/extracts/hyper/trends_long.hyper" default-settings='yes' schema='Extract' sslmode='' tablename='Extract' username='' /></named-connection></named-connections><relation connection='hyper.trends' name='Extract' table='[Extract].[Extract]' type='table' /></connection><aliases enabled='yes' /><column caption="Keep skill" datatype='boolean' name="[Calculation_trends_1]" role='dimension' type='nominal'><calculation class='tableau' formula="[skill] = [Parameters].[Parameter 7]" /></column></datasource><datasource caption="model_long" inline='true' name="federated.model_long" version='18.1'><connection class='federated'><named-connections><named-connection caption="model_long" name='hyper.model_long'><connection authentication='auth-none' class='hyper' dbname="/Users/kireeti/Desktop/Projects/Career-Market-Intelligence/tableau_dashboard/extracts/hyper/model_results_long.hyper" default-settings='yes' schema='Extract' sslmode='' tablename='Extract' username='' /></named-connection></named-connections><relation connection='hyper.model_long' name='Extract' table='[Extract].[Extract]' type='table' /></connection><aliases enabled='yes' /><column caption="Grouped band accuracy" datatype='string' name="[Calculation_model_long_1]" role='measure' type='nominal'><calculation class='tableau' formula="STR(ROUND(SUM(IF [task]='band' AND [evaluation]='employer_grouped_cv' AND [measure]='Model' THEN [value] END) * 100, 1)) + '%'" /></column><column caption="Grouped binary accuracy" datatype='string' name="[Calculation_model_long_2]" role='measure' type='nominal'><calculation class='tableau' formula="STR(ROUND(SUM(IF [task]='binary' AND [evaluation]='employer_grouped_cv' AND [measure]='Model' THEN [value] END) * 100, 1)) + '%'" /></column><column caption="Guess band" datatype='string' name="[Calculation_model_long_3]" role='measure' type='nominal'><calculation class='tableau' formula="STR(ROUND(SUM(IF [task]='band' AND [evaluation]='employer_grouped_cv' AND [measure]='Guessing' THEN [value] END) * 100, 1)) + '%'" /></column><column caption="Guess binary" datatype='string' name="[Calculation_model_long_4]" role='measure' type='nominal'><calculation class='tableau' formula="STR(ROUND(SUM(IF [task]='binary' AND [evaluation]='employer_grouped_cv' AND [measure]='Guessing' THEN [value] END) * 100, 1)) + '%'" /></column></datasource><datasource caption="confusion" inline='true' name="federated.confusion" version='18.1'><connection class='federated'><named-connections><named-connection caption="confusion" name='hyper.confusion'><connection authentication='auth-none' class='hyper' dbname="/Users/kireeti/Desktop/Projects/Career-Market-Intelligence/tableau_dashboard/extracts/hyper/confusion_matrix.hyper" default-settings='yes' schema='Extract' sslmode='' tablename='Extract' username='' /></named-connection></named-connections><relation connection='hyper.confusion' name='Extract' table='[Extract].[Extract]' type='table' /></connection><aliases enabled='yes' /><column caption="Keep task" datatype='boolean' name="[Calculation_confusion_1]" role='dimension' type='nominal'><calculation class='tableau' formula="[task] = [Parameters].[Parameter 8]" /></column></datasource><datasource caption="importance" inline='true' name="federated.importance" version='18.1'><connection class='federated'><named-connections><named-connection caption="importance" name='hyper.importance'><connection authentication='auth-none' class='hyper' dbname="/Users/kireeti/Desktop/Projects/Career-Market-Intelligence/tableau_dashboard/extracts/hyper/feature_importance_top10.hyper" default-settings='yes' schema='Extract' sslmode='' tablename='Extract' username='' /></named-connection></named-connections><relation connection='hyper.importance' name='Extract' table='[Extract].[Extract]' type='table' /></connection><aliases enabled='yes' /><column caption="Keep task" datatype='boolean' name="[Calculation_importance_1]" role='dimension' type='nominal'><calculation class='tableau' formula="[task] = [Parameters].[Parameter 8]" /></column></datasource><datasource caption="predictions" inline='true' name="federated.predictions" version='18.1'><connection class='federated'><named-connections><named-connection caption="predictions" name='hyper.predictions'><connection authentication='auth-none' class='hyper' dbname="/Users/kireeti/Desktop/Projects/Career-Market-Intelligence/tableau_dashboard/extracts/hyper/predictions.hyper" default-settings='yes' schema='Extract' sslmode='' tablename='Extract' username='' /></named-connection></named-connections><relation connection='hyper.predictions' name='Extract' table='[Extract].[Extract]' type='table' /></connection><aliases enabled='yes' /><column caption="Keep profile" datatype='boolean' name="[Calculation_predictions_1]" role='dimension' type='nominal'><calculation class='tableau' formula="[role] = [Parameters].[Parameter 9] AND [seniority] = [Parameters].[Parameter 10] AND [state] = [Parameters].[Parameter 11] AND [contract] = [Parameters].[Parameter 12] AND [skill_profile] = [Parameters].[Parameter 13]" /></column><column caption="P low" datatype='stri